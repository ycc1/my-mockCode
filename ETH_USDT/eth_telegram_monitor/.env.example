# Copy to .env. Never upload .env or send secrets via chat.
SYMBOL=ETHUSDT
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# every_minute: send one Telegram report on each successful minute check
# alerts_only: important events + initial report + 60-minute heartbeat
NOTIFY_MODE=every_minute
AI_INTERVAL_MINUTES=1
NEWS_INTERVAL_MINUTES=30
INCLUDE_SPOT=true
MAX_QUOTE_AGE_SECONDS=90

PRICE_ALERT_1M_PERCENT=0.35
PRICE_ALERT_5M_PERCENT=1.00
VOLUME_ALERT_MULTIPLE=2.5
FUNDING_ALERT_ABS_PERCENT=0.03
ALERT_COOLDOWN_MINUTES=10
